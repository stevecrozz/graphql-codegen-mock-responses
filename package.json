{
  "name": "graphql-codegen-mock-responses",
  "version": "0.2.0",
  "description": "GraphQL Codegen plugin that generates typed factory functions for operation responses",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test tests/**/*.spec.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "graphql",
    "codegen",
    "graphql-codegen",
    "plugin",
    "typescript",
    "mock",
    "factory",
    "testing"
  ],
  "author": "Stephen Crosby",
  "license": "MIT",
  "peerDependencies": {
    "graphql": "^16.0.0"
  },
  "dependencies": {
    "@faker-js/faker": "^9.0.0",
    "@graphql-codegen/plugin-helpers": "^5.0.0",
    "change-case-all": "^2.1.0",
    "sentence-case": "^4.0.0"
  },
  "devDependencies": {
    "graphql": "^16.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
