# Makes `npm version` create a signed annotated tag (git tag -s) rather than a lightweight
# one. Only affects `npm version`, i.e. only whoever cuts a release -- installs and every
# other npm command are untouched, so this does not impose anything on contributors. The
# publish registry lives in package.json's publishConfig instead, because a registry pin
# here *would* override installs for everyone who clones.
sign-git-tag=true
